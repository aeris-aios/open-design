# Copy to deploy/cf/.env and fill in. Compose reads it automatically when run
# with -f cf/docker-compose.cf.yml from the deploy/ directory... run from cf/
# itself so relative paths in the compose file resolve: cd deploy/cf.

# Daemon API auth (openssl rand -hex 32). The gate injects this as a Bearer
# token on every proxied request; the daemon rejects anything without it.
OD_API_TOKEN=

# Shared with the DESIGN_STUDIO_EMBED_SECRET env on the Commerce Fountain
# Vercel project (openssl rand -hex 32). Signs embed tokens + session cookies.
DESIGN_STUDIO_EMBED_SECRET=

# Powers the Claude Code CLI inside the container (headless).
ANTHROPIC_API_KEY=
