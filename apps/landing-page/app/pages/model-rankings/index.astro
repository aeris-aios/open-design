const scenarios = [
  { id: 'landing', label: isZh ? '落地页' : 'Landing page', detail: isZh ? '品牌表达与转化路径' : 'Brand expression and conversion', fit: isZh ? '适合品牌表达与转化要求高的页面。' : 'For pages where brand expression and conversion matter most.', color: '#ef7442', area: '1 / 1 / 3 / 4' },
  { id: 'dashboard', label: 'Dashboard', detail: isZh ? '信息密度与数据层级' : 'Information density and hierarchy', fit: isZh ? '适合高信息密度的分析与运营工作台。' : 'For analytics and operations surfaces with dense information.', color: '#6756d8', area: '1 / 4 / 2 / 7' },
  { id: 'desktop', label: isZh ? '桌面客户端' : 'Desktop app', detail: isZh ? '桌面工作流与复杂交互' : 'Desktop workflows and complex interactions', fit: isZh ? '适合多面板、复杂状态和桌面工作流。' : 'For multi-panel interfaces, complex states, and desktop workflows.', color: '#4f43bb', area: '2 / 4 / 3 / 7' },
  { id: 'mobile', label: isZh ? '移动端界面' : 'Mobile UI', detail: isZh ? '触控体验与响应式布局' : 'Touch and responsive layout', fit: isZh ? '适合强调触控路径与小屏适配的产品。' : 'For products centered on touch flows and small-screen adaptation.', color: '#319d6a', area: '1 / 7 / 3 / 9' },
  { id: 'webapp', label: isZh ? 'Web 端 App' : 'Web app', detail: isZh ? '多页面结构与操作流' : 'Multi-page structure and flows', fit: isZh ? '适合多页面、复杂操作流和产品状态。' : 'For multi-page products with complex flows and application states.', color: '#1589e8', area: '1 / 9 / 3 / 11' },
];

const clamp = (value: number, min: number, max: number) => Math.max(min, Math.min(max, value));
const scenarioOffset = (scenarioIndex: number, modelIndex: number) => ((scenarioIndex * 11 + modelIndex * 7) % 15) - 7;
const scenarioResults = models.map((model, modelIndex) => ({
  ...model,
  scenarios: scenarios.map((scenario, scenarioIndex) => {
    const offset = scenarioOffset(scenarioIndex, modelIndex);
    const d1 = Number(clamp(model.d1 + offset * .16, 19.5, 30).toFixed(1));
    const d2 = Number(clamp(model.d2 + offset * .38, 40, 70).toFixed(1));
    const score = Number((d1 + d2).toFixed(1));
    return {
      id: scenario.id,
      d1,
      d2,
      score,
      pdr: Number(clamp(model.pdr + offset * .48, 55, 96).toFixed(1)),
      ttft: Number((model.ttft * (1 + scenarioIndex * .035 + Math.max(0, offset) * .01)).toFixed(2)),
      time: Number((model.time * (1 + scenarioIndex * .08 + Math.max(0, offset) * .008)).toFixed(0)),
      cacheHit: Number(clamp(model.cacheHit - scenarioIndex * 1.5 - Math.max(0, offset) * .45, 20, 82).toFixed(1)),
      inputTokens: Number((model.inputTokens * (1 + scenarioIndex * .07 + Math.max(0, offset) * .009)).toFixed(0)),
      outputTokens: Number((model.outputTokens * (1 + scenarioIndex * .06 + Math.max(0, offset) * .008)).toFixed(0)),
      cost: Number((model.cost * (1 + scenarioIndex * .07 + Math.max(0, offset) * .006)).toFixed(2)),
      calls: Number((model.calls * (1 + scenarioIndex * .06 + Math.max(0, offset) * .007)).toFixed(1)),
    };
  }),
}));

const costPlotX = (cost: number) => {
  const minimum = Math.log(.35);
  const maximum = Math.log(3);
  return Number(clamp(8 + ((Math.log(cost) - minimum) / (maximum - minimum)) * 84, 8, 92).toFixed(2));
};
const costPlotY = (pdr: number) => Number(clamp(8 + ((pdr - 60) / 36) * 84, 8, 92).toFixed(2));

const leaderboardGroups = [
  {
    id: 'overall',
    label: isZh ? '综合总榜' : 'Overall',
    detail: isZh ? '所有五个设计场景的综合表现' : 'Combined performance across all five design scenarios',
    rows: scenarioResults.map((model) => ({
      name: model.name, maker: model.maker, icon: model.icon, color: model.color, badge: model.badge,
      score: Number((model.d1 + model.d2).toFixed(1)), pdr: model.pdr, cost: model.cost,
      x: costPlotX(model.cost), y: costPlotY(model.pdr),
    })).sort((a, b) => b.score - a.score),
  },
  ...scenarios.map((scenario, scenarioIndex) => ({
    id: scenario.id,
    label: scenario.label,
    detail: scenario.detail,
    rows: scenarioResults.map((model) => {
      const result = model.scenarios[scenarioIndex]!;
      return {
        name: model.name, maker: model.maker, icon: model.icon, color: model.color, badge: model.badge,
        score: result.score, pdr: result.pdr, cost: result.cost,
        x: costPlotX(result.cost), y: costPlotY(result.pdr),
      };
    }).sort((a, b) => b.score - a.score),
  })),
];

type DecisionPriority = 'overall' | 'design' | 'requirement' | 'speed' | 'cost';
type DecisionRole = 'primary' | 'value' | 'faster';
type DecisionRow = {
  name: string;
  maker: string;
  icon: string;
  color: string;
  badge?: string;
  score: number;
  pdr: number;
  d1: number;
  d2: number;
  cost: number;
  ttft: number;
};

const decisionRowsFor = (scenarioId: string): DecisionRow[] => scenarioResults.map((model) => {
  const result = scenarioId === 'overall' ? null : model.scenarios.find((item) => item.id === scenarioId);
  return {
    name: model.name,
    maker: model.maker,
    icon: model.icon,
    color: model.color,
    badge: model.badge,
    score: result?.score ?? Number((model.d1 + model.d2).toFixed(1)),
    pdr: result?.pdr ?? model.pdr,
    d1: result?.d1 ?? model.d1,
    d2: result?.d2 ?? model.d2,
    cost: result?.cost ?? model.cost,
    ttft: result?.ttft ?? model.ttft,
  };
});

const recommendationsFor = (scenarioId: string, priority: DecisionPriority) => {
  const rows = decisionRowsFor(scenarioId);
  const reliable = rows.filter((row) => row.pdr >= 75);
  const rankedPrimary = [...(priority === 'cost' ? reliable.filter((row) => row.cost > 0) : rows)].sort((a, b) => {
    if (priority === 'design') return b.d2 - a.d2 || b.pdr - a.pdr;
    if (priority === 'requirement') return b.d1 - a.d1 || b.pdr - a.pdr;
    if (priority === 'speed') return a.ttft - b.ttft || b.pdr - a.pdr;
    if (priority === 'cost') return a.cost - b.cost || b.pdr - a.pdr;
    return b.pdr - a.pdr || b.score - a.score;
  });
  const primary = rankedPrimary[0] ?? rows[0]!;
  const valuePool = rows.filter((row) => row.cost > 0 && row.pdr >= 80 && row.name !== primary.name);
  const valueFallback = reliable.filter((row) => row.cost > 0 && row.name !== primary.name);
  const value = [...(valuePool.length ? valuePool : valueFallback)].sort((a, b) => (b.pdr / Math.sqrt(b.cost)) - (a.pdr / Math.sqrt(a.cost)))[0]
    ?? rows.find((row) => row.name !== primary.name)!;
  const faster = [...reliable].filter((row) => row.name !== primary.name && row.name !== value.name).sort((a, b) => a.ttft - b.ttft || b.pdr - a.pdr)[0]
    ?? rows.find((row) => row.name !== primary.name && row.name !== value.name)!;
  return [primary, value, faster] as const;
};

const decisionReason = (row: DecisionRow, role: DecisionRole, priority: DecisionPriority) => {
  if (role === 'value') return isZh
    ? `${row.pdr.toFixed(1)}% PDR · 单次成本约 $${row.cost.toFixed(2)}。`
    : `${row.pdr.toFixed(1)}% PDR · about $${row.cost.toFixed(2)} per run.`;
  if (role === 'faster') return isZh
    ? `TTFT 约 ${row.ttft.toFixed(2)} 秒。`
    : `About ${row.ttft.toFixed(2)}s TTFT.`;
  if (priority === 'design') return isZh ? `D2 设计质量 ${row.d2.toFixed(1)}/70。` : `D2 design quality: ${row.d2.toFixed(1)}/70.`;
  if (priority === 'requirement') return isZh ? `D1 需求完成度 ${row.d1.toFixed(1)}/30。` : `D1 requirement fulfillment: ${row.d1.toFixed(1)}/30.`;
  if (priority === 'speed') return isZh ? `TTFT 约 ${row.ttft.toFixed(2)} 秒。` : `About ${row.ttft.toFixed(2)}s TTFT.`;
  if (priority === 'cost') return isZh ? `单次成本约 $${row.cost.toFixed(2)}。` : `About $${row.cost.toFixed(2)} per run.`;
  return isZh
    ? `${row.pdr.toFixed(1)}% PDR · 原始分 ${row.score.toFixed(1)}。`
    : `${row.pdr.toFixed(1)}% PDR · ${row.score.toFixed(1)} raw score.`;
};

const initialRecommendations = recommendationsFor('overall', 'overall');
const initialRecommendationRoles: DecisionRole[] = ['primary', 'value', 'faster'];

const efficiencyX = (model: Model) => Math.max(5, Math.min(95, 5 + (model.ttft / 2.4) * 90));
const efficiencyY = (model: Model) => Math.max(6, Math.min(94, 6 + ((model.pdr - 65) / 25) * 88));

const title = copy.title;
const description = copy.description;
const modelsJson = JSON.stringify(scenarioResults).replace(/</g, '\\u003c');
const scenariosJson = JSON.stringify(scenarios).replace(/</g, '\\u003c');
const clientCopyJson = JSON.stringify({
  percentage: copy.percentage,
  score: copy.score,
  scale: isZh ? '刻度' : 'scale',
  module: {
    ttft: { title: isZh ? '× 首次响应' : 'vs First response', xLabel: isZh ? 'TTFT（越左越快 →）' : 'TTFT (faster on the left →)' },
    duration: { title: isZh ? '× 完成耗时' : 'vs Completion time', xLabel: isZh ? '完成耗时（越左越快 →）' : 'Completion time (faster on the left →)' },
    cacheHit: { title: isZh ? '× 缓存命中率' : 'vs Cache hit rate', xLabel: isZh ? '缓存命中率（越右越高 →）' : 'Cache hit rate (higher on the right →)' },
    inputTokens: { title: isZh ? '× 输入 Token' : 'vs Input tokens', xLabel: isZh ? '输入 Token 数（越左越少 →）' : 'Input tokens (fewer on the left →)' },
    outputTokens: { title: isZh ? '× 输出 Token' : 'vs Output tokens', xLabel: isZh ? '输出 Token 数（越左越少 →）' : 'Output tokens (fewer on the left →)' },
  },
  scenario: isZh ? '场景' : 'scenario',
  allScenarios: isZh ? '综合' : 'Overall',
  quality: isZh ? '原始分' : 'Score',
  pdr: 'PDR',
  lowerBetter: copy.lowerBetter,
  higherBetter: isZh ? '越高越好' : 'higher is better',
  metricSummary: isZh ? { ttft: 'TTFT', duration: '耗时', cacheHit: '缓存', inputTokens: '输入', outputTokens: '输出' } : { ttft: 'TTFT', duration: 'Time', cacheHit: 'Cache', inputTokens: 'Input', outputTokens: 'Output' },
  guide: {
    roles: decisionCopy.roles,
    details: decisionCopy.details,
    reasons: isZh ? {
      value: '{pdr}% PDR · 单次成本约 ${cost}。',
      faster: 'TTFT 约 {ttft} 秒。',
      overall: '{pdr}% PDR · 原始分 {score}。',
      design: 'D2 设计质量 {metric}/70。',
      requirement: 'D1 需求完成度 {metric}/30。',
      speed: 'TTFT 约 {ttft} 秒。',
      cost: '单次成本约 ${cost}。',
    } : {
      value: '{pdr}% PDR · about ${cost} per run.',
      faster: 'About {ttft}s TTFT.',
      overall: '{pdr}% PDR · {score} raw score.',
      design: 'D2 design quality: {metric}/70.',
      requirement: 'D1 requirement fulfillment: {metric}/30.',
      speed: 'About {ttft}s TTFT.',
      cost: 'About ${cost} per run.',
    },
  },
}).replace(/</g, '\\u003c');
---

<Layout
  title={title}
  description={description}
  active="resources"
  mainClassName="model-index-main"
>
  <article class="model-index-page" data-model-index>
    <header class="model-index-intro">
      <p class="model-index-kicker">{copy.kicker}</p>
      <h1>{copy.heading}</h1>
      <p>{copy.intro}</p>
      <div class="model-hero-actions">
        <a class="model-cta-btn model-cta-btn-primary" href={href(DOWNLOAD_HREF)}>
          {copy.ctaDownload}<span class="model-cta-btn-arrow" aria-hidden="true">→</span>
        </a>
        <a class="model-cta-btn" href={OPEN_DESIGN_DISCORD} target="_blank" rel="noopener">{copy.ctaDiscord}</a>
        <span class="model-hero-note">{copy.ctaDownloadNote}</span>
      </div>
      <a class="model-guide-link" href="#quick-pick-title">{decisionCopy.heroLink}<span aria-hidden="true">↓</span></a>
      <div class="model-index-note"><span>{copy.preview}</span><p>{copy.previewNote}</p></div>
    </header>

    <section class="model-section model-guide-section" aria-labelledby="quick-pick-title" data-model-guide>
      <div class="section-heading guide-heading">
        <div>
          <span class="section-index">{decisionCopy.eyebrow}</span>
          <h2 id="quick-pick-title">{decisionCopy.heading}</h2>
          <p>{decisionCopy.description}</p>
        </div>
      </div>
      <div class="model-guide-shell">
        <div class="model-guide-controls">
          <div class="model-guide-control">
            <strong>{decisionCopy.scenarioLabel}</strong>
            <div role="group" aria-label={decisionCopy.scenarioLabel}>
              <button type="button" class="active" aria-pressed="true" data-guide-scenario="overall">{decisionCopy.overall}</button>
              {scenarios.map((scenario) => <button type="button" aria-pressed="false" data-guide-scenario={scenario.id}><i style={`background:${scenario.color}`}></i>{scenario.label}</button>)}
            </div>
          </div>
          <div class="model-guide-control">
            <strong>{decisionCopy.priorityLabel}</strong>
            <div role="group" aria-label={decisionCopy.priorityLabel}>
              {decisionCopy.priorities.map(([id, label], index) => <button type="button" class:list={{ active: index === 0 }} aria-pressed={index === 0 ? 'true' : 'false'} data-guide-priority={id}>{label}</button>)}
            </div>
          </div>
        </div>
        <div class="model-guide-results" aria-live="polite">
          {initialRecommendations.map((row, index) => {
            const role = initialRecommendationRoles[index]!;
            return (
              <article class:list={['model-recommendation', { 'is-primary': index === 0 }]} data-recommendation-card={index} style={`--recommendation-color:${row.color}`}>
                <div class="model-recommendation-topline"><span data-rec-role>{decisionCopy.roles[index]}</span><small data-rec-maker>{row.maker}</small></div>
                <header>
                  <span class="model-icon"><img data-rec-icon src={row.icon} alt="" width="32" height="32" /></span>
                  <h3 data-rec-name>{row.name}</h3>
                </header>
                <p data-rec-reason>{decisionReason(row, role, 'overall')}</p>
                <dl>
                  <div><dt>{isZh ? '原始分' : 'Score'}</dt><dd data-rec-score>{row.score.toFixed(1)}</dd></div>
                  <div><dt>PDR</dt><dd data-rec-pdr>{row.pdr.toFixed(1)}%</dd></div>
                  <div><dt>{isZh ? '单次成本' : 'Cost / run'}</dt><dd data-rec-cost>${row.cost.toFixed(2)}</dd></div>
                </dl>
                <a data-rec-link href={index === 2 ? '#analysis-title' : '#leaderboard-title'}>{decisionCopy.details}<span aria-hidden="true">→</span></a>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="model-section leaderboard-section" aria-labelledby="leaderboard-title">
      <div class="section-heading">
        <div>
          <h2 id="leaderboard-title">{copy.leaderboard}</h2>
          <p>{copy.leaderboardDesc}</p>
        </div>
      </div>

      <div class="leaderboard-insights" aria-label={isZh ? '综合榜关键指标' : 'Overall ranking highlights'}>
        {initialRecommendations.map((row, index) => (
          <div style={`--insight-color:${row.color}`}>
            <span>{decisionCopy.overallSignals[index]}</span>
            <strong><span class="model-icon"><img src={row.icon} alt="" width="24" height="24" /></span>{row.name}</strong>
            <small>{index === 0 ? `${row.pdr.toFixed(1)}% PDR` : index === 1 ? `$${row.cost.toFixed(2)} / ${isZh ? '次' : 'run'}` : `TTFT ${row.ttft.toFixed(2)}s`}</small>
          </div>
        ))}
      </div>

      <div class="score-primer" aria-label={copy.scoreAria}>
        {copy.primer.map(([code, label], index) => index === copy.primer.length - 1 ? (
          <a href="#analysis-title"><strong>{code}</strong><small>{label}</small></a>
        ) : (
          <span><strong>{code}</strong><small>{label}</small></span>
        ))}
      </div>

      <ModelRankingPair group={leaderboardGroups[0]!} isZh={isZh} prominent />
    </section>

    <section class="model-section scenario-rankings-section" aria-labelledby="task-title">
      <div class="section-heading">
        <div><h2 id="task-title">{decisionCopy.scenarioHeading}</h2><p>{decisionCopy.scenarioDescription}</p></div>
      </div>
      <nav class="task-map" aria-label={isZh ? '五个设计场景' : 'Five design scenarios'}>
        {leaderboardGroups.slice(1).map((group, index) => {
          const scene = scenarios[index]!;
          const winner = group.rows[0]!;
          return (
            <a class="task-tile" href={`#scenario-${group.id}`} style={`background:${scene.color};grid-area:${scene.area}`}>
              <span>{group.label}</span><small>{group.detail}</small>
              <div class="task-winner">
                <span class="model-icon"><img src={winner.icon} alt="" width="24" height="24" /></span>
                <strong>{winner.name}</strong><b>{winner.score.toFixed(1)}<small>/100</small></b>
              </div>
            </a>
          );
        })}
      </nav>
      <div class="scenario-ranking-stack">
        {leaderboardGroups.slice(1).map((group, index) => {
          const scene = scenarios[index]!;
          const winner = group.rows[0]!;
          return (
            <article class="scenario-benchmark" id={`scenario-${group.id}`}>
              <header class="scenario-benchmark-head">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div><h3>{group.label}</h3><p>{group.detail}</p></div>
                <div class="scenario-verdict" style={`--scenario-color:${scene.color}`}>
                  <small>{decisionCopy.sceneChoice}</small>
                  <strong><span class="model-icon"><img src={winner.icon} alt="" width="24" height="24" /></span>{winner.name}</strong>
                  <p>{scene.fit}</p>
                  <dl><span>{winner.score.toFixed(1)} {isZh ? '分' : 'score'}</span><span>{winner.pdr.toFixed(1)}% PDR</span><span>${winner.cost.toFixed(2)} / {isZh ? '次' : 'run'}</span></dl>
                </div>
              </header>
              <ModelRankingPair group={group} isZh={isZh} />
            </article>
          );
        })}
      </div>
    </section>

    <section class="model-section analysis-section" aria-labelledby="analysis-title">
      <div class="section-heading">
        <div><h2 id="analysis-title">{copy.analysisHeading}</h2><p>{copy.analysisDesc}{isZh ? '效率数据单独报告，不计入 PDR。' : ' Efficiency is reported separately and does not affect PDR.'}</p></div>
      </div>
      <div class="analysis-explorer" data-analysis>
        <div class="analysis-toolbar">
          <div class="analysis-tabs" role="tablist" aria-label={copy.analysisAria}>
            <button type="button" role="tab" aria-selected="true" aria-controls="analysis-efficiency" class="active" data-analysis-view="ttft"><strong>{copy.ttft}</strong></button>
            <button type="button" role="tab" aria-selected="false" aria-controls="analysis-efficiency" data-analysis-view="duration"><strong>{copy.duration}</strong></button>
            <button type="button" role="tab" aria-selected="false" aria-controls="analysis-efficiency" data-analysis-view="cacheHit"><strong>{copy.cacheHit}</strong></button>
            <button type="button" role="tab" aria-selected="false" aria-controls="analysis-efficiency" data-analysis-view="inputTokens"><strong>{copy.inputTokens}</strong></button>
            <button type="button" role="tab" aria-selected="false" aria-controls="analysis-efficiency" data-analysis-view="outputTokens"><strong>{copy.outputTokens}</strong></button>
          </div>
          <div class="efficiency-quality-tabs" role="group" aria-label={isZh ? '纵轴分数' : 'Quality axis'}>
            <button type="button" class="active" aria-pressed="true" data-efficiency-quality="score">{isZh ? '原始分' : 'Score'}</button>
            <button type="button" aria-pressed="false" data-efficiency-quality="pdr">PDR</button>
          </div>
        </div>
        <div class="efficiency-filter-bar">
          <div class="scenario-filter" role="group" aria-label={isZh ? '选择评测场景' : 'Select evaluation scene'}>
            <button type="button" class="active" aria-pressed="true" data-efficiency-scenario="overall">{isZh ? '综合' : 'Overall'}</button>
            {scenarios.map((scenario) => <button type="button" aria-pressed="false" data-efficiency-scenario={scenario.id}><i style={`background:${scenario.color}`}></i>{scenario.label}</button>)}
          </div>
          <div class="difficulty-control"><span>{copy.difficulty}</span><div class="difficulty-tabs" role="group" aria-label={copy.difficulty}><button type="button" aria-pressed="false" data-efficiency-difficulty="simple">{copy.simple}</button><button type="button" class="active" aria-pressed="true" data-efficiency-difficulty="general">{copy.general}</button><button type="button" aria-pressed="false" data-efficiency-difficulty="difficult">{copy.difficult}</button><i class="difficulty-indicator"></i></div></div>
        </div>

        <div id="analysis-efficiency" class="analysis-panel" role="tabpanel" data-analysis-panel="efficiency">
          <div class="efficiency-chart-shell">
            <div class="efficiency-chart-main">
              <div class="efficiency-chart-copy"><span data-efficiency-eyebrow>{isZh ? '综合 · 一般任务 · 数值越低越好' : 'Overall · General tasks · lower is better'}</span><h3 data-efficiency-title>{isZh ? '原始分 × 首次响应' : 'Score vs First response'}</h3><p>{copy.chartDesc}</p></div>
              <div class="efficiency-chart-stage">
                <span class="efficiency-y-title" data-efficiency-y-label>{isZh ? '原始分（越高越好 ↑）' : 'Score (higher ↑)'}</span><span class="efficiency-x-title" data-efficiency-x-label>{isZh ? 'TTFT（越左越快 →）' : 'TTFT (faster on the left →)'}</span>
                <div class="efficiency-y-ticks" aria-hidden="true" data-efficiency-y-ticks><span>95</span><span>85</span><span>75</span><span>65</span></div>
                <div class="efficiency-x-ticks" aria-hidden="true"><span>0s</span><span>0.6s</span><span>1.2s</span><span>1.8s</span><span>2.4s</span></div>
                <div class="efficiency-plot">
                  <div class="efficiency-ideal-zone"><span>{isZh ? '高分 · 高效率' : 'High score · High efficiency'}</span></div>
                  <svg class="efficiency-frontier" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><polyline points=""></polyline></svg>
                  {scenarioResults.map((model, index) => (
                    <div class:list={['efficiency-point', { 'is-highlighted': index < 4 }]} data-efficiency-point={model.name} style={`left:${efficiencyX(model)}%;bottom:${efficiencyY(model)}%;--point-color:${model.color}`}>
                      <span class="model-icon"><img src={model.icon} alt="" width="28" height="28" /></span>
                      <span class="efficiency-point-label"><strong>{model.name}</strong><small>TTFT {model.ttft}s · {isZh ? '耗时' : 'Time'} {model.time}s<br />{isZh ? '缓存' : 'Cache'} {model.cacheHit}% · {isZh ? '输入' : 'Input'} {(model.inputTokens / 1000).toFixed(1)}K · {isZh ? '输出' : 'Output'} {(model.outputTokens / 1000).toFixed(1)}K</small></span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <aside class="efficiency-model-index">
              <div class="model-index-heading"><span>{copy.models}</span><strong data-model-count>{models.length}</strong></div>
              <div class="efficiency-model-list">
                {models.map((model) => (
                  <div class="efficiency-model-row" data-efficiency-row={model.name}>
                    <span class="model-icon"><img src={model.icon} alt="" width="28" height="28" /></span>
                    <span><strong>{model.name}{model.badge ? <em class="model-badge">{model.badge}</em> : null}</strong><small>{model.maker}</small></span><b>{model.ttft}s</b>
                  </div>
                ))}
              </div>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <section class="model-section compare-section" aria-labelledby="compare-title">
      <div class="section-heading"><div><h2 id="compare-title">{isZh ? '模型对比' : 'Compare models'}</h2><p>{isZh ? '选择二到三个模型，把综合分、三项核心指标与五场景表现放在同一视图中比较。' : 'Select two or three models to compare overall results, core metrics, and all five scenes.'}</p></div></div>
      <div class="compare-picker" role="group" aria-label={isZh ? '选择对比模型' : 'Select models to compare'}>
        {scenarioResults.map((model, index) => <button type="button" class:list={{ active: index < 3 }} aria-pressed={index < 3 ? 'true' : 'false'} data-compare-model={model.name}><span class="model-icon"><img src={model.icon} alt="" width="22" height="22" /></span>{model.name}</button>)}
      </div>
      <div class="compare-grid" data-compare-grid></div>
    </section>

    <section class="model-section method-section" aria-labelledby="method-title">
      <div class="section-heading"><div><h2 id="method-title">{copy.methodHeading}</h2><p>{copy.methodDesc}</p></div></div>
      <div class="method-overview">
        <div class="method-primary"><span>{copy.primaryMetric}</span><div><strong>PDR</strong><h3>{copy.pdrName}</h3></div><p>{copy.pdrDesc}</p></div>
        <ol class="method-flow" aria-label={copy.flowAria}>
          {copy.flow.map(([title, detail]) => <li><span><strong>{title}</strong><small>{detail}</small></span></li>)}
        </ol>
      </div>
      <div class="method-table">
        {methodCards.map(([code, badge, heading, body, bullets]) => (
          <article><header><span>{code}</span><em>{badge}</em></header><h3>{heading}</h3><p>{body}</p><ul>{bullets.map((bullet) => <li>{bullet}</li>)}</ul></article>
        ))}
      </div>
      <div class="method-disclosure">
        {copy.disclosures.map(([heading, body]) => <div><strong>{heading}</strong><p>{body}</p></div>)}
      </div>
    </section>

    <aside class="ranking-strip">
      <p>{copy.stripLead}</p>
      <a href={href(DOWNLOAD_HREF)}>{copy.stripCta}<span aria-hidden="true"> →</span></a>
    </aside>
  </article>
  <script is:inline type="application/json" id="model-rankings-data" set:html={modelsJson}></script>
  <script is:inline type="application/json" id="model-rankings-scenarios" set:html={scenariosJson}></script>
  <script is:inline type="application/json" id="model-rankings-copy" set:html={clientCopyJson}></script>
  <script>
    type EfficiencyModule = 'ttft' | 'duration' | 'cacheHit' | 'inputTokens' | 'outputTokens';
    type Difficulty = 'simple' | 'general' | 'difficult';
    type QualityMetric = 'score' | 'pdr';
    type ScenarioId = 'overall' | string;
    type GuidePriority = 'overall' | 'design' | 'requirement' | 'speed' | 'cost';
    type ScenarioResult = { id: string; d1: number; d2: number; score: number; pdr: number; ttft: number; time: number; cacheHit: number; inputTokens: number; outputTokens: number; cost: number; calls: number };
    type ClientModel = {
      name: string;
      maker: string;
      icon: string;
      color: string;
      badge?: string;
      pdr: number;
      d0: number;
      d1: number;
      d2: number;
      ttft: number;
      time: number;
      cacheHit: number;
      inputTokens: number;
      outputTokens: number;
      cost: number;
      calls: number;
      scenarios: ScenarioResult[];
    };
    type ClientScenario = { id: string; label: string; fit: string; color: string };
    type ClientCopy = {
      percentage: string;
      score: string;
      scale: string;
      module: Record<EfficiencyModule, { title: string; xLabel: string; suffix?: string }>;
      scenario: string;
      allScenarios: string;
      quality: string;
      pdr: string;
      lowerBetter: string;
      higherBetter: string;
      metricSummary: Record<EfficiencyModule, string>;
      guide: {
        roles: string[];
        details: string;
        reasons: Record<'value' | 'faster' | GuidePriority, string>;
      };
    };

    const root = document.querySelector<HTMLElement>('[data-model-index]');
    const dataElement = document.querySelector<HTMLScriptElement>('#model-rankings-data');
    const scenariosElement = document.querySelector<HTMLScriptElement>('#model-rankings-scenarios');
    const copyElement = document.querySelector<HTMLScriptElement>('#model-rankings-copy');
    if (root && dataElement && scenariosElement && copyElement) {
      const modelData = JSON.parse(dataElement.textContent || '[]') as ClientModel[];
      const scenarioData = JSON.parse(scenariosElement.textContent || '[]') as ClientScenario[];
      const clientCopy = JSON.parse(copyElement.textContent || '{}') as ClientCopy;

      let activeGuideScenario = 'overall';
      let activeGuidePriority: GuidePriority = 'overall';
      const guideRowsFor = (scenarioId: string) => modelData.map((model) => {
        const result = scenarioId === 'overall' ? null : model.scenarios.find((item) => item.id === scenarioId);
        return {
          ...model,
          score: result?.score ?? model.d1 + model.d2,
          pdr: result?.pdr ?? model.pdr,
          d1: result?.d1 ?? model.d1,
          d2: result?.d2 ?? model.d2,
          cost: result?.cost ?? model.cost,
          ttft: result?.ttft ?? model.ttft,
        };
      });
      const guideRecommendations = (scenarioId: string, priority: GuidePriority) => {
        const rows = guideRowsFor(scenarioId);
        const reliable = rows.filter((row) => row.pdr >= 75);
        const primaryPool = priority === 'cost' ? reliable.filter((row) => row.cost > 0) : rows;
        const primary = [...primaryPool].sort((a, b) => {
          if (priority === 'design') return b.d2 - a.d2 || b.pdr - a.pdr;
          if (priority === 'requirement') return b.d1 - a.d1 || b.pdr - a.pdr;
          if (priority === 'speed') return a.ttft - b.ttft || b.pdr - a.pdr;
          if (priority === 'cost') return a.cost - b.cost || b.pdr - a.pdr;
          return b.pdr - a.pdr || b.score - a.score;
        })[0] || rows[0]!;
        const highConfidenceValue = rows.filter((row) => row.cost > 0 && row.pdr >= 80 && row.name !== primary.name);
        const valueFallback = reliable.filter((row) => row.cost > 0 && row.name !== primary.name);
        const value = [...(highConfidenceValue.length ? highConfidenceValue : valueFallback)].sort((a, b) => (b.pdr / Math.sqrt(b.cost)) - (a.pdr / Math.sqrt(a.cost)))[0]
          || rows.find((row) => row.name !== primary.name)!;
        const faster = [...reliable].filter((row) => row.name !== primary.name && row.name !== value.name).sort((a, b) => a.ttft - b.ttft || b.pdr - a.pdr)[0]
          || rows.find((row) => row.name !== primary.name && row.name !== value.name)!;
        return [primary, value, faster];
      };
      const guideReason = (row: ReturnType<typeof guideRowsFor>[number], role: 'primary' | 'value' | 'faster') => {
        const key = role === 'primary' ? activeGuidePriority : role;
        const metric = activeGuidePriority === 'design' ? row.d2 : row.d1;
        return clientCopy.guide.reasons[key]
          .replace('{pdr}', row.pdr.toFixed(1))
          .replace('{score}', row.score.toFixed(1))
          .replace('{cost}', row.cost.toFixed(2))
          .replace('{ttft}', row.ttft.toFixed(2))
          .replace('{metric}', metric.toFixed(1));
      };
      const renderGuide = () => {
        const roles = ['primary', 'value', 'faster'] as const;
        guideRecommendations(activeGuideScenario, activeGuidePriority).forEach((row, index) => {
          const card = root.querySelector<HTMLElement>(`[data-recommendation-card="${index}"]`);
          if (!card) return;
          card.style.setProperty('--recommendation-color', row.color);
          const icon = card.querySelector<HTMLImageElement>('[data-rec-icon]');
          const name = card.querySelector<HTMLElement>('[data-rec-name]');
          const maker = card.querySelector<HTMLElement>('[data-rec-maker]');
          const role = card.querySelector<HTMLElement>('[data-rec-role]');
          const reason = card.querySelector<HTMLElement>('[data-rec-reason]');
          const score = card.querySelector<HTMLElement>('[data-rec-score]');
          const pdr = card.querySelector<HTMLElement>('[data-rec-pdr]');
          const cost = card.querySelector<HTMLElement>('[data-rec-cost]');
          const link = card.querySelector<HTMLAnchorElement>('[data-rec-link]');
          if (icon) icon.src = row.icon;
          if (name) name.textContent = row.name;
          if (maker) maker.textContent = row.maker;
          if (role) role.textContent = clientCopy.guide.roles[index] || '';
          if (reason) reason.textContent = guideReason(row, roles[index]!);
          if (score) score.textContent = row.score.toFixed(1);
          if (pdr) pdr.textContent = `${row.pdr.toFixed(1)}%`;
          if (cost) cost.textContent = `$${row.cost.toFixed(2)}`;
          if (link) link.href = index === 2 ? '#analysis-title' : activeGuideScenario === 'overall' ? '#leaderboard-title' : `#scenario-${activeGuideScenario}`;
        });
      };
      root.querySelectorAll<HTMLButtonElement>('[data-guide-scenario]').forEach((button) => button.addEventListener('click', () => {
        activeGuideScenario = button.dataset.guideScenario || 'overall';
        root.querySelectorAll<HTMLButtonElement>('[data-guide-scenario]').forEach((item) => {
          const selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        renderGuide();
      }));
      root.querySelectorAll<HTMLButtonElement>('[data-guide-priority]').forEach((button) => button.addEventListener('click', () => {
        activeGuidePriority = (button.dataset.guidePriority || 'overall') as GuidePriority;
        root.querySelectorAll<HTMLButtonElement>('[data-guide-priority]').forEach((item) => {
          const selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        renderGuide();
      }));

      root.querySelectorAll<HTMLElement>('[data-ranking-card]').forEach((card) => {
        const list = card.querySelector<HTMLElement>('.ranking-list');
        const label = card.querySelector<HTMLElement>('[data-ranking-value-label]');
        const buttons = [...card.querySelectorAll<HTMLButtonElement>('[data-ranking-view]')];
        const render = (view: 'score' | 'percentage') => {
          const rows = [...card.querySelectorAll<HTMLElement>('[data-ranking-row]')].sort((a, b) => Number(b.dataset[view] || 0) - Number(a.dataset[view] || 0));
          rows.forEach((row, index) => {
            const value = Number(row.dataset[view] || 0);
            const height = Math.max(12, Math.min(84, (value - 50) * 1.7));
            const position = row.querySelector<HTMLElement>('[data-ranking-position]');
            const valueNode = row.querySelector<HTMLElement>('.ranking-value');
            if (position) position.textContent = String(index + 1);
            row.style.setProperty('--model-value', String(value));
            row.style.setProperty('--model-height', `${height}%`);
            if (valueNode) valueNode.innerHTML = view === 'percentage' ? `<strong>${value.toFixed(1)}%</strong><small></small>` : `<strong>${value.toFixed(1)}</strong><small>/100</small>`;
            list?.append(row);
          });
          if (label) label.textContent = view === 'percentage' ? clientCopy.percentage : clientCopy.score;
          buttons.forEach((button) => {
            const selected = button.dataset.rankingView === view;
            button.classList.toggle('active', selected);
            button.setAttribute('aria-selected', String(selected));
          });
        };
        buttons.forEach((button) => button.addEventListener('click', () => render(button.dataset.rankingView as 'score' | 'percentage')));
        render('score');
      });

      // 常驻标签的方向：构建期只能按百分比估算，误差够大到会撞。
      // 这里用真实几何重算一次，按名次依次放，每个都避开其它模型的点和已放好的标签。
      const overlap = (a: DOMRect, b: DOMRect) => a.right > b.left && a.left < b.right && a.bottom > b.top && a.top < b.bottom;
      root.querySelectorAll<HTMLElement>('.cost-plot').forEach((plot) => {
        const points = [...plot.querySelectorAll<HTMLElement>('.cost-point')];
        const placed: DOMRect[] = [];
        points.filter((point) => point.classList.contains('is-labeled')).forEach((point) => {
          const label = point.querySelector<HTMLElement>('.cost-point-label');
          if (!label) return;
          const bounds = plot.getBoundingClientRect();
          let best: { dir: string; cost: number } | null = null;
          for (const dir of ['up', 'down', 'up-right', 'up-left', 'down-right', 'down-left', 'right', 'left']) {
            point.dataset.labelDir = dir;
            const rect = label.getBoundingClientRect();
            let cost = rect.left < bounds.left - 62 || rect.right > bounds.right + 62 || rect.top < bounds.top - 32 || rect.bottom > bounds.bottom + 32 ? 3 : 0;
            points.forEach((other) => { if (other !== point && overlap(rect, other.getBoundingClientRect())) cost += 1; });
            placed.forEach((rows) => { if (overlap(rect, rows)) cost += 2; });
            if (!best || cost < best.cost) best = { dir, cost };
            if (cost === 0) break;
          }
          // 放不下就不放：第 1 名保底常驻，2、3 名只在能干净落位时才常驻，
          // 否则退回 hover 显示 —— 密集的图里宁可少两个标签，也不要压字。
          if (best!.cost > 0 && placed.length > 0) {
            point.classList.remove('is-labeled');
            delete point.dataset.labelDir;
            return;
          }
          point.dataset.labelDir = best!.dir;
          placed.push(label.getBoundingClientRect());
        });
      });

      const formatTokens = (value: number) => `${(value / 1000).toFixed(value >= 10000 ? 0 : 1)}K`;
      const moduleConfig = {
        ttft: { label: clientCopy.module.ttft.title, xLabel: clientCopy.module.ttft.xLabel, maximum: 2.4, ticks: [0, .6, 1.2, 1.8, 2.4], higherBetter: false, format: (value: number) => `${value.toFixed(2)}s` },
        duration: { label: clientCopy.module.duration.title, xLabel: clientCopy.module.duration.xLabel, maximum: 340, ticks: [0, 85, 170, 255, 340], higherBetter: false, format: (value: number) => `${Math.round(value)}s` },
        cacheHit: { label: clientCopy.module.cacheHit.title, xLabel: clientCopy.module.cacheHit.xLabel, maximum: 100, ticks: [0, 25, 50, 75, 100], higherBetter: true, format: (value: number) => `${value.toFixed(1)}%` },
        inputTokens: { label: clientCopy.module.inputTokens.title, xLabel: clientCopy.module.inputTokens.xLabel, maximum: 70000, ticks: [0, 17500, 35000, 52500, 70000], higherBetter: false, format: formatTokens },
        outputTokens: { label: clientCopy.module.outputTokens.title, xLabel: clientCopy.module.outputTokens.xLabel, maximum: 12000, ticks: [0, 3000, 6000, 9000, 12000], higherBetter: false, format: formatTokens },
      } satisfies Record<EfficiencyModule, { label: string; xLabel: string; maximum: number; ticks: number[]; higherBetter: boolean; format: (value: number) => string }>;
      const difficultyConfig: Record<Difficulty, { factor: number; cacheDelta: number; label: string }> = {
        simple: { factor: .78, cacheDelta: 6, label: document.documentElement.lang.startsWith('zh') ? '简单任务' : 'Simple tasks' },
        general: { factor: 1, cacheDelta: 0, label: document.documentElement.lang.startsWith('zh') ? '一般任务' : 'General tasks' },
        difficult: { factor: 1.3, cacheDelta: -7, label: document.documentElement.lang.startsWith('zh') ? '困难任务' : 'Difficult tasks' },
      };
      let activeModule: EfficiencyModule = 'ttft';
      let activeScenario: ScenarioId = 'overall';
      let activeQuality: QualityMetric = 'score';
      let activeDifficulty: Difficulty = 'general';

      const resultFor = (model: ClientModel) => activeScenario === 'overall' ? model : model.scenarios.find((result) => result.id === activeScenario) || model;
      const qualityFor = (model: ClientModel) => {
        const result = resultFor(model) as ClientModel | ScenarioResult;
        return activeQuality === 'pdr' ? result.pdr : ('score' in result ? result.score : result.d1 + result.d2);
      };
      const valueFor = (model: ClientModel, module: EfficiencyModule = activeModule) => {
        const result = resultFor(model) as ClientModel | ScenarioResult;
        const difficulty = difficultyConfig[activeDifficulty];
        if (module === 'ttft') return result.ttft * difficulty.factor;
        if (module === 'duration') return result.time * difficulty.factor;
        if (module === 'cacheHit') return Math.max(0, Math.min(100, result.cacheHit + difficulty.cacheDelta));
        if (module === 'inputTokens') return result.inputTokens * difficulty.factor;
        return result.outputTokens * difficulty.factor;
      };
      const renderEfficiency = () => {
        const config = moduleConfig[activeModule];
        const scene = activeScenario === 'overall' ? clientCopy.allScenarios : scenarioData.find((item) => item.id === activeScenario)?.label || activeScenario;
        const qualityLabel = activeQuality === 'score' ? clientCopy.quality : clientCopy.pdr;
        const eyebrow = root.querySelector<HTMLElement>('[data-efficiency-eyebrow]');
        const titleNode = root.querySelector<HTMLElement>('[data-efficiency-title]');
        const yLabel = root.querySelector<HTMLElement>('[data-efficiency-y-label]');
        const xLabel = root.querySelector<HTMLElement>('[data-efficiency-x-label]');
        const xTicks = root.querySelector<HTMLElement>('.efficiency-x-ticks');
        const yTicks = root.querySelector<HTMLElement>('[data-efficiency-y-ticks]');
        if (eyebrow) eyebrow.textContent = `${scene} · ${difficultyConfig[activeDifficulty].label} · ${config.higherBetter ? clientCopy.higherBetter : clientCopy.lowerBetter}`;
        if (titleNode) titleNode.textContent = `${qualityLabel} ${config.label}`;
        if (yLabel) yLabel.textContent = `${qualityLabel} (${activeQuality === 'pdr' ? '%' : '/100'})`;
        if (xLabel) xLabel.textContent = config.xLabel;
        if (xTicks) xTicks.innerHTML = config.ticks.map((tick) => `<span>${config.format(tick)}</span>`).join('');
        if (yTicks) yTicks.innerHTML = (activeQuality === 'pdr' ? [95, 85, 75, 65] : [96, 86, 76, 66]).map((tick) => `<span>${tick}</span>`).join('');
        const plot = root.querySelector<HTMLElement>('.efficiency-plot');
        plot?.classList.toggle('is-higher-better', config.higherBetter);
        const points = modelData.map((model) => {
          const value = valueFor(model);
          const quality = qualityFor(model);
          return { model, value, quality, x: Math.max(5, Math.min(95, 5 + value / config.maximum * 90)), y: Math.max(6, Math.min(94, 6 + (quality - 62) / 35 * 88)) };
        });
        points.forEach(({ model, value, x, y }) => {
          const point = root.querySelector<HTMLElement>(`[data-efficiency-point="${CSS.escape(model.name)}"]`);
          const row = root.querySelector<HTMLElement>(`[data-efficiency-row="${CSS.escape(model.name)}"]`);
          if (point) {
            point.style.left = `${x}%`;
            point.style.bottom = `${y}%`;
            const label = point.querySelector<HTMLElement>('small');
            if (label) label.innerHTML = `${clientCopy.metricSummary.ttft} ${moduleConfig.ttft.format(valueFor(model, 'ttft'))} · ${clientCopy.metricSummary.duration} ${moduleConfig.duration.format(valueFor(model, 'duration'))}<br>${clientCopy.metricSummary.cacheHit} ${moduleConfig.cacheHit.format(valueFor(model, 'cacheHit'))} · ${clientCopy.metricSummary.inputTokens} ${moduleConfig.inputTokens.format(valueFor(model, 'inputTokens'))} · ${clientCopy.metricSummary.outputTokens} ${moduleConfig.outputTokens.format(valueFor(model, 'outputTokens'))}`;
          }
          const rowValue = row?.querySelector<HTMLElement>('b');
          if (rowValue) rowValue.textContent = config.format(value);
        });
        const ranked = [...points].sort((a, b) => config.higherBetter ? b.value - a.value : a.value - b.value);
        const list = root.querySelector<HTMLElement>('.efficiency-model-list');
        ranked.forEach(({ model }, index) => {
          const point = root.querySelector<HTMLElement>(`[data-efficiency-point="${CSS.escape(model.name)}"]`);
          point?.classList.toggle('is-highlighted', index < 4);
          const row = root.querySelector<HTMLElement>(`[data-efficiency-row="${CSS.escape(model.name)}"]`);
          if (row) list?.append(row);
        });
        let best = -Infinity;
        const frontier = ranked.filter((point) => {
          if (point.quality <= best) return false;
          best = point.quality;
          return true;
        });
        const polyline = root.querySelector<SVGPolylineElement>('.efficiency-frontier polyline');
        if (polyline) polyline.setAttribute('points', frontier.map((point) => `${point.x},${100 - point.y}`).join(' '));
      };

      root.querySelectorAll<HTMLButtonElement>('[data-analysis-view]').forEach((button) => button.addEventListener('click', () => {
        activeModule = button.dataset.analysisView as EfficiencyModule;
        root.querySelectorAll<HTMLButtonElement>('[data-analysis-view]').forEach((item) => {
          const selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-selected', String(selected));
        });
        renderEfficiency();
      }));
      root.querySelectorAll<HTMLButtonElement>('[data-efficiency-scenario]').forEach((button) => button.addEventListener('click', () => {
        activeScenario = button.dataset.efficiencyScenario || 'overall';
        root.querySelectorAll<HTMLButtonElement>('[data-efficiency-scenario]').forEach((item) => {
          const selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        renderEfficiency();
      }));
      root.querySelectorAll<HTMLButtonElement>('[data-efficiency-quality]').forEach((button) => button.addEventListener('click', () => {
        activeQuality = button.dataset.efficiencyQuality as QualityMetric;
        root.querySelectorAll<HTMLButtonElement>('[data-efficiency-quality]').forEach((item) => {
          const selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        renderEfficiency();
      }));
      root.querySelectorAll<HTMLButtonElement>('[data-efficiency-difficulty]').forEach((button, index) => button.addEventListener('click', () => {
        activeDifficulty = button.dataset.efficiencyDifficulty as Difficulty;
        root.querySelectorAll<HTMLButtonElement>('[data-efficiency-difficulty]').forEach((item) => {
          const selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        const indicator = root.querySelector<HTMLElement>('.difficulty-indicator');
        indicator?.style.setProperty('--indicator-x', `${index * 100}%`);
        renderEfficiency();
      }));

      let comparedModels = modelData.slice(0, 3).map((model) => model.name);
      const renderCompare = () => {
        const grid = root.querySelector<HTMLElement>('[data-compare-grid]');
        if (!grid) return;
        grid.innerHTML = comparedModels.map((name) => {
          const model = modelData.find((item) => item.name === name)!;
          const sceneRows = model.scenarios.map((result) => {
            const scenario = scenarioData.find((item) => item.id === result.id)!;
            return `<div><span><i style="background:${scenario.color}"></i>${scenario.label}</span><b>${result.score.toFixed(1)}</b></div>`;
          }).join('');
          return `<article class="compare-card" style="--compare-color:${model.color}">
            <header><span class="model-icon"><img src="${model.icon}" alt="" width="28" height="28"></span><span><strong>${model.name}${model.badge ? `<em class="model-badge">${model.badge}</em>` : ''}</strong><small>${model.maker}</small></span></header>
            <div class="compare-headline"><span>PDR <strong>${model.pdr.toFixed(1)}%</strong></span><span>${clientCopy.quality} <strong>${(model.d1 + model.d2).toFixed(1)}</strong></span></div>
            <div class="compare-metrics"><div><small>D1</small><strong>${model.d1.toFixed(1)}<i>/30</i></strong></div><div><small>D2</small><strong>${model.d2.toFixed(1)}<i>/70</i></strong></div><div><small>Speed</small><strong>${model.time}s</strong></div><div><small>Cost</small><strong>$${model.cost.toFixed(2)}</strong></div><div><small>Calls</small><strong>${model.calls.toFixed(1)}</strong></div></div>
            <div class="compare-scenes">${sceneRows}</div>
          </article>`;
        }).join('');
        root.querySelectorAll<HTMLButtonElement>('[data-compare-model]').forEach((button) => {
          const selected = comparedModels.includes(button.dataset.compareModel || '');
          button.classList.toggle('active', selected);
          button.setAttribute('aria-pressed', String(selected));
        });
      };
      root.querySelectorAll<HTMLButtonElement>('[data-compare-model]').forEach((button) => button.addEventListener('click', () => {
        const name = button.dataset.compareModel || '';
        if (comparedModels.includes(name)) {
          if (comparedModels.length > 2) comparedModels = comparedModels.filter((item) => item !== name);
        } else if (comparedModels.length < 3) {
          comparedModels = [...comparedModels, name];
        } else {
          comparedModels = [...comparedModels.slice(1), name];
        }
        renderCompare();
      }));

      renderGuide();
      renderEfficiency();
      renderCompare();
    }
  </script>
</Layout>
