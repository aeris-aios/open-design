---
type RankingRow = {
  name: string;
  maker: string;
  icon: string;
  color: string;
  score: number;
  pdr: number;
  cost: number;
  x: number;
  y: number;
};

type RankingGroup = {
  id: string;
  label: string;
  detail: string;
  rows: RankingRow[];
};

interface Props {
  group: RankingGroup;
  isZh: boolean;
  prominent?: boolean;
}

const { group, isZh, prominent = false } = Astro.props;
const scoreLabel = isZh ? '原始分' : 'Score';
const percentageLabel = isZh ? 'PDR 通过率' : 'PDR rate';
const modelLabel = isZh ? '模型' : 'Model';
const rankingTitle = isZh ? `${group.label}排名` : `${group.label} ranking`;
const costTitle = isZh ? `${group.label} PDR × 成本` : `${group.label} PDR vs cost`;
const costDescription = isZh ? '左上象限代表用更低成本获得更高的通过率。' : 'The upper-left quadrant combines a higher PDR rate with a lower session cost.';
const chartHeight = (value: number) => Math.max(12, Math.min(92, (value - 50) * 2));

// 高效区边界按本组真实数据推导，而不是写死象限：
// 锚点 = PDR 第一梯队（前半）里成本最低的模型，区域刚好把它包进来。
// 写死 52%/50% 时锚点会卡在边界外，绿区看起来永远没人达标。
const byPdr = [...group.rows].sort((a, b) => b.pdr - a.pdr);
const topTier = byPdr.slice(0, Math.ceil(byPdr.length / 2));
const zoneAnchor = topTier.reduce((best, row) => (row.cost < best.cost ? row : best), topTier[0]!);
// 边界取锚点与相邻模型的中点，避免某个点正好压在虚线上
const nextBelow = Math.max(...group.rows.filter((row) => row.y < zoneAnchor.y).map((row) => row.y), 0);
const nextRight = Math.min(...group.rows.filter((row) => row.x > zoneAnchor.x).map((row) => row.x), 100);
const zoneWidth = Math.min(96, (zoneAnchor.x + nextRight) / 2);
const zoneHeight = Math.min(96, 100 - (zoneAnchor.y + nextBelow) / 2);
---

<div class:list={['ranking-pair', { 'ranking-pair-prominent': prominent }]}>
  <section class="ranking-card" data-ranking-card data-scenario={group.id} aria-label={rankingTitle}>
    <header class="benchmark-card-head">
      <div>
        <h3>{rankingTitle}</h3>
      </div>
      <div class="ranking-card-controls">
        <span class="model-count">{group.rows.length} {isZh ? '个模型' : 'models'}</span>
        <div class="ranking-view-tabs" role="tablist" aria-label={isZh ? `${group.label}排名数值` : `${group.label} ranking value`}>
          <button type="button" class="active" role="tab" aria-selected="true" data-ranking-view="score">{scoreLabel}</button>
          <button type="button" role="tab" aria-selected="false" data-ranking-view="percentage">{percentageLabel}</button>
        </div>
      </div>
    </header>
    <div class="ranking-chart">
      <div class="ranking-chart-scroll">
        <div class="ranking-list" aria-label={modelLabel}>
          {group.rows.map((model, index) => (
            <div
              class="ranking-row"
              data-ranking-row={model.name}
              data-score={model.score}
              data-percentage={model.pdr}
              style={`--model-color:${model.color};--model-value:${model.score};--model-height:${chartHeight(model.score)}%`}
            >
              <span class="ranking-track">
                <span class="ranking-fill">
                  <span class="ranking-value"><strong>{model.score.toFixed(1)}</strong><small>/100</small></span>
                  <span class="model-icon"><img src={model.icon} alt="" width="28" height="28" /></span>
                </span>
              </span>
              <span class="ranking-model">
                <i data-ranking-position>{index + 1}</i>
                <span><strong>{model.name}</strong><small>{model.maker}</small></span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="cost-card" aria-label={`${group.label} ${costTitle}`}>
    <header class="benchmark-card-head cost-card-head">
      <div><h3>{costTitle}</h3><p>{costDescription}</p></div>
    </header>
    <div class="cost-stage">
      <span class="cost-y-label">{percentageLabel} ({isZh ? '越高越好' : 'higher is better'})</span>
      <span class="cost-x-label">{isZh ? '单次任务成本（越低越好）' : 'Cost per session (lower is better)'}</span>
      <div class="cost-y-ticks" aria-hidden="true"><span>95%</span><span>85%</span><span>75%</span><span>65%</span></div>
      <div class="cost-x-ticks" aria-hidden="true"><span>$0.35</span><span>$0.60</span><span>$1.00</span><span>$2.00</span><span>$3.00</span></div>
      <div class="cost-plot">
        <div class="cost-ideal-zone" style={`--zone-w:${zoneWidth}%;--zone-h:${zoneHeight}%`}><span>{isZh ? '高通过率 / 低成本' : 'High PDR / low cost'}</span></div>
        {group.rows.map((model, index) => (
          <span
            class:list={['cost-point', { 'is-leading': index < 4, 'is-labeled': index < 3, 'is-winner': index === 0 }]}
            style={`--x:${model.x}%;--y:${model.y}%;--point-color:${model.color}`}
            aria-label={`${model.name}: ${model.pdr.toFixed(1)}%, $${model.cost.toFixed(2)}`}
            tabindex="0"
          >
            {index < 4 ? <span class="model-icon"><img src={model.icon} alt="" width="26" height="26" /></span> : null}
            <span class="cost-point-label"><strong>{model.name}</strong><small>{model.pdr.toFixed(1)}% / ${model.cost.toFixed(2)}</small></span>
          </span>
        ))}
      </div>
    </div>
  </section>
</div>
