{
  "name": "@open-design/preview-runtime",
  "version": "0.20.3",
  "private": true,
  "type": "module",
  "description": "Shared injected preview-runtime builders and browser-side helpers for Open Design HTML artifacts.",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./manual-edit": {
      "types": "./dist/manual-edit.d.ts",
      "default": "./dist/manual-edit.mjs"
    }
  },
  "scripts": {
    "build": "node ./esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "esbuild": "0.28.0",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": "~24"
  }
}
